# Kopieren nach .env und Werte anpassen. .env wird NIE committet (siehe .gitignore).

# --- Postgres (Docspell-Datenbank) ---
POSTGRES_USER=docspell
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=docspell

# --- Docspell ---
# Zufälligen Wert erzeugen z.B. mit: openssl rand -hex 32
DOCSPELL_INTEGRATION_SECRET=change-me-to-a-long-random-value
# Name der Docspell-"Collective" (Mandant), in die alles einsortiert wird
DOCSPELL_COLLECTIVE=firma
DOCSPELL_BASE_URL=http://docspell-restserver:7880

# --- Gmail Connector ---
# Nur lesender Zugriff (gmail.readonly). Absender/Stichwort-Regeln stehen in config/sources.yaml
GMAIL_POLL_INTERVAL_SECONDS=900
GMAIL_LABEL=INBOX

# --- Amazon Connector ---
AMAZON_DOMAIN=amazon.de
AMAZON_POLL_INTERVAL_SECONDS=21600
AMAZON_ORDER_LOOKBACK_DAYS=45
