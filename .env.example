# Kopieren nach .env und Werte anpassen. .env wird NIE committet (siehe .gitignore).

# --- Postgres (Docspell-Datenbank) ---
POSTGRES_USER=docspell
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=docspell

# --- Docspell ---
# Zufälligen Wert erzeugen z.B. mit: openssl rand -hex 32
DOCSPELL_INTEGRATION_SECRET=change-me-to-a-long-random-value
# Name der Docspell-"Collective" (Mandant), in die alles einsortiert wird
DOCSPELL_COLLECTIVE=firma
DOCSPELL_BASE_URL=http://docspell-restserver:7880
# "closed" = niemand kann sich neue Konten anlegen (sicherer Normalzustand).
# Für die Ersteinrichtung kurz auf "open" stellen, "docker compose up -d"
# ausführen, unter http://localhost:7880 die Konten anlegen, danach WIEDER
# auf "closed" zurückstellen und erneut "docker compose up -d".
DOCSPELL_SIGNUP_MODE=closed
# Standardmässig nur von diesem Rechner selbst erreichbar (127.0.0.1). Falls
# SSH-Portforwarding auf dem NAS nicht funktioniert ("administratively
# prohibited"), hier vorübergehend 0.0.0.0 eintragen für Zugriff per
# http://<NAS-LAN-IP>:7880 aus dem eigenen Netz — danach wieder auf
# 127.0.0.1 zurückstellen.
DOCSPELL_BIND_HOST=127.0.0.1
# Images liegen auf ghcr.io (Docker Hub "docspell/restserver" ist archiviert).
# "latest" ist bestätigt funktionierend; für eine gepinnte Version konkrete
# Tags hier durchsuchen: https://github.com/docspell/docspell/pkgs/container/restserver
DOCSPELL_VERSION=latest
# Normaler Docspell-Nutzer-Login (NICHT das Integration-Secret oben) — wird
# dauerhaft vom "connector-mirror-sync"-Dienst genutzt (Suche + Original-
# Download, für die richtige Datums-Einsortierung im Jahr/Monat-Ordnerbaum,
# siehe MONTHLY_MIRROR_HOST_PATH unten) sowie optional für den manuellen
# Steuerberater-Export (docker compose run --rm export-tax-advisor ...).
DOCSPELL_ACCOUNT=firma/dein-nutzername
DOCSPELL_PASSWORD=

# --- Gmail Connector ---
# Nur lesender Zugriff (gmail.readonly). Absender/Stichwort-Regeln stehen in config/sources.yaml
GMAIL_POLL_INTERVAL_SECONDS=900
GMAIL_LABEL=INBOX
GMAIL_ALERT_AFTER_FAILURES=3

# --- Monatsordner-Spiegelung (Jahr/Monat-Ordnerbaum für den Steuerberater) ---
# Gepflegt vom periodisch laufenden connector-mirror-sync (siehe unten) direkt
# aus Docspells eigenem, von der OCR erkannten Beleg-Datum — erfasst ALLE
# Docspell-Items der Collective, nicht nur per Connector hochgeladene:
# <Pfad>/<Jahr>/<Eingang oder Ausgang>/<Monat>/datei.pdf (ohne erkanntes
# Datum: <Pfad>/ohne-datum/<Eingang oder Ausgang>/datei.pdf)
MONTHLY_MIRROR_HOST_PATH=./data/belege-nach-monat
# Wie oft der Ordnerbaum mit Docspell abgeglichen wird (Sekunden). Muss nicht
# so kurz wie die Upload-Connectors sein — die Datei ist ja längst in
# Docspell durchsuchbar, dieser Ordnerbaum ist nur der zusätzliche
# Dateisystem-Spiegel für den Steuerberater.
MIRROR_SYNC_POLL_INTERVAL_SECONDS=1800
MIRROR_SYNC_ALERT_AFTER_FAILURES=3

# Amazon Business: kein eigener Connector/keine eigenen Variablen — 1-2x im Jahr
# manueller Bulk-Export, siehe docs/amazon-business-export.md.

# --- Dropzone Connector (manuelles Scannen per Handy + Amazon-Export, siehe connectors/dropzone/README.md) ---
# Enthält die Unterordner eingang/ und ausgang/ (werden beim Start automatisch angelegt)
DROPZONE_HOST_PATH=./data/dropzone
DROPZONE_POLL_INTERVAL_SECONDS=60
DROPZONE_ALERT_AFTER_FAILURES=3

# --- Syncthing (synct den Dropzone-Ordner mit dem Handy, siehe connectors/dropzone/README.md) ---
# Versionsgepinnt statt "latest" — aktuellen Tag prüfen: https://github.com/syncthing/syncthing/releases
SYNCTHING_VERSION=1.27.12
# Gleiches Muster wie DOCSPELL_BIND_HOST: Web-UI standardmäßig nur per
# SSH-Tunnel erreichbar. Falls SSH-Portforwarding auf dem NAS nicht
# funktioniert, hier vorübergehend 0.0.0.0 eintragen (Zugriff dann per
# http://<NAS-LAN-IP>:8384, z.B. zum Handy koppeln) — danach wieder auf
# 127.0.0.1 zurückstellen.
SYNCTHING_BIND_HOST=127.0.0.1

# --- Tailscale (Fernzugriff auf Docspell + Syncthing ohne offene Router-Ports,
# siehe docs/tailscale-remote-access.md) ---
# Versionsgepinnt statt "latest" — aktuellen Tag prüfen:
# https://github.com/tailscale/tailscale/pkgs/container/tailscale
TAILSCALE_VERSION=v1.102.3
# Auth-Key aus der Tailscale-Adminkonsole (Settings -> Keys -> "Generate auth
# key"). "Reusable" an, "Ephemeral" AUS lassen, sonst verschwindet das Gerät
# nach jedem Container-Neustart aus dem Tailnet und muss neu autorisiert
# werden. Leer lassen geht auch (dann einmalig "docker compose logs tailscale"
# nach einem Login-Link durchsuchen), ein Auth-Key ist aber deutlich bequemer.
TAILSCALE_AUTHKEY=
# Name, unter dem das Gerät im Tailnet auftaucht (z.B. für MagicDNS
# "belegwirtschaft.<tailnet-name>.ts.net").
TAILSCALE_HOSTNAME=belegwirtschaft

# --- Benachrichtigungen (optional) ---
# Leer lassen = keine Benachrichtigungen. Für selbst gehostetes ntfy:
# https://github.com/binwiederhier/ntfy — läuft am besten als weiterer, eigener
# Service in eurem Netz, nicht Teil dieses Repos.
NTFY_URL=
NTFY_TOPIC=

# --- Backup (scripts/backup.sh) ---
# Ziel + Passphrase für restic (Verschlüsselung passiert VOR dem Verlassen dieses
# Rechners, das Backup-Ziel selbst muss also nicht vertrauenswürdig sein).
RESTIC_REPOSITORY=/mnt/backup-nas/belegwirtschaft
RESTIC_PASSWORD=change-me-to-a-long-random-passphrase
