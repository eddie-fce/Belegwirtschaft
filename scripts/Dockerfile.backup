# Build-Kontext ist das Projekt-Root (siehe docker-compose.yml, Service
# "backup"). Kein eigenständig laufender Dienst — wird per Cron über
# "docker compose run --rm backup" aufgerufen (siehe backup.sh-Kopfzeilen).
#
# Basis-Image bewusst dasselbe wie der "db"-Dienst (postgres:16-alpine),
# NICHT ein generisches Debian/Ubuntu mit "postgresql-client" — Debian
# bookworms Standardpaket liefert nur pg_dump 15, das verweigert den Dump
# von einem neueren (16er) Server ("server version mismatch"). So ist
# pg_dump garantiert zur selben Server-Version passend.
FROM postgres:16-alpine

RUN apk add --no-cache restic

WORKDIR /app
COPY scripts/backup.sh .
RUN chmod +x backup.sh

ENTRYPOINT ["./backup.sh"]
